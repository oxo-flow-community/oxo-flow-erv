# TEtranscripts / TEcount — locus-level quantification, one sample at a time.
#
# TEcount is the per-sample counter shipped with TEtranscripts; no control
# sample is needed here (that is only for the `TEtranscripts` differential step).
# It is given the gene GTF and the ERV exon GTF, so gene and TE reads are
# assigned in one pass and compete against each other, as the tool intends.
#
# TEcount writes its coordinate-sorted temporary BAM into the process working
# directory, so the job runs inside a scratch directory.  Every path handed to
# TEcount is made absolute first — a relative --outdir would land inside the
# scratch directory and be deleted with it.

[workflow]
name = "erv-tetranscripts"
version = "1.0.0"
description = "TEcount locus-level ERV quantification with gene+TE competition."
author = "oxo-flow-community"

[[rules]]
name = "tetranscripts_count"
description = "Run TEcount on the coordinate-sorted BAM"
input = [
    "{config.out_dir}/bam/{sample}/{sample}.sorted.bam",
    "{config.gene_gtf}",
    "{config.out_dir}/annotation/te_locus.exon.gtf",
]
output = ["{config.out_dir}/tetranscripts/{sample}/{sample}.cntTable"]
log = "{config.out_dir}/logs/tetranscripts/{sample}.log"
shell = """
set -eo pipefail
OUT=$(readlink -f {config.out_dir})
LOG=$(readlink -f {log})
mkdir -p "$OUT/tetranscripts/{sample}" "$OUT/_tmp" "$(dirname "$LOG")"
TMP=$OUT/_tmp/{sample}.tecount
rm -rf "$TMP" && mkdir -p "$TMP"
BAM=$(readlink -f {input[0]})
GTF=$(readlink -f {input[1]})
TE=$(readlink -f {input[2]})
cd "$TMP"
export TMPDIR="$TMP"
TEcount --sortByPos --format BAM --mode multi \
    -b "$BAM" \
    --GTF "$GTF" --TE "$TE" \
    --project {sample} \
    --outdir "$OUT/tetranscripts/{sample}" >> "$LOG" 2>&1
cd /
rm -rf "$TMP"
"""

[rules.resources]
threads = 1
memory = "8G"

[rules.environment]
conda = "envs/tetranscripts.yaml"
